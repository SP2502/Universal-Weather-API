# Create deployments/docker/.env locally; never commit real secrets.
# Development only; rotate this password before deploying anywhere shared.
UWA_POSTGRES_PASSWORD=replace-with-a-long-random-development-password

# Change if Windows reserves port 8080.
UWA_GATEWAY_HOST_PORT=8080
OPENWEATHER_API_KEY=
WEATHERAPI_API_KEY=
LOCATIONIQ_API_KEY=

# Optional free-plan geocoding. Create your own account and review its terms.
GEOAPIFY_API_KEY=
APP_ENABLE_GEOAPIFY=false

# Local noncommercial testing only. Set full_experimental to test the
# deferred air-quality, history and marine routes.
APP_DEPLOYMENT_USE=noncommercial
APP_RELEASE_PROFILE=lean_v1
APP_ENABLE_OPEN_METEO_FORECAST=false
APP_ENABLE_OPEN_METEO_GEOCODING=false
APP_ENABLE_OPEN_METEO_AIR_QUALITY=false
APP_ENABLE_OPEN_METEO_HISTORY=false
APP_ENABLE_OPEN_METEO_MARINE=false
APP_ENABLE_SUNRISE_SUNSET=false

# Optional keyless regional forecast/alerts providers need a real contact
# User-Agent and an operator-reviewed geographic policy before activation.
APP_ENABLE_MET_NORWAY=false
APP_MET_NORWAY_USER_AGENT=
APP_ENABLE_US_NWS=false
APP_ENABLE_US_NWS_ALERTS=false
APP_NWS_USER_AGENT=
APP_ENABLE_BRIGHT_SKY=false

# Compose mounts this file read-only as /etc/uwa/provider-policy.json.
# Replace with your reviewed copy to enable additional providers.
UWA_PROVIDER_POLICY_HOST_FILE=../../configs/provider-policy.example.json

# Add explicit conservative budgets for every enabled provider. The JSON must
# be one line. Check your actual account plan; examples are not entitlements.
APP_PROVIDER_QUOTAS_JSON=
