[Unit]
Description=Universal Weather API self-hosted gateway
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=uwa
Group=uwa
EnvironmentFile=/etc/universal-weather-api/gateway.env
ExecStart=/usr/local/bin/uwa-gateway
Restart=on-failure
RestartSec=5s
TimeoutStartSec=45s
TimeoutStopSec=35s
WatchdogSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/universal-weather-api
StateDirectory=universal-weather-api
StateDirectoryMode=0700
# Gateway is intentionally bound to loopback unless explicitly configured.

[Install]
WantedBy=multi-user.target
