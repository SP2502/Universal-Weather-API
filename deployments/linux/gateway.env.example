# Private runtime configuration; never commit your real gateway.env.
APP_ENV=production
APP_BIND_HOST=127.0.0.1
APP_PORT=8080
APP_DB_DRIVER=postgres
APP_DATABASE_URL=postgres://uwa:REPLACE_ME@127.0.0.1:5432/uwa?sslmode=require
APP_CACHE_DRIVER=memory
APP_SECRET_DRIVER=env
APP_LOG_LEVEL=INFO
# Provide at least one valid upstream provider key before starting.
OPENWEATHER_API_KEY=
WEATHERAPI_API_KEY=
LOCATIONIQ_API_KEY=

# Phase 06 candidates are disabled until operator policies and licensing are reviewed.
# APP_PROVIDER_POLICY_FILE=/etc/uwa/provider-policy.json
# APP_DEPLOYMENT_USE=noncommercial
# GEOAPIFY_API_KEY=
# APP_ENABLE_GEOAPIFY=false
# APP_ENABLE_MET_NORWAY=false
# APP_MET_NORWAY_USER_AGENT=UniversalWeatherAPI/1.0 https://your-domain.example/contact
# APP_ENABLE_OPEN_METEO_FORECAST=false
# APP_ENABLE_OPEN_METEO_GEOCODING=false
# When both Open-Meteo endpoints are enabled, the two entries must share a
# verified upstream allowance group. All numbers and charge units are ILLUSTRATIVE.
# APP_PROVIDER_QUOTAS_JSON={"geoapify":{"unit":"credits","per_second":4,"per_minute":180,"per_day":2800},"open_meteo_forecast":{"group":"open_meteo_shared","per_minute":250,"per_day":4400},"open_meteo_geocoding":{"group":"open_meteo_shared","per_minute":250,"per_day":4400}}

# Phase 06 Wave B regional forecast adapters (disabled by default).
# These require a reviewed policy enabling the exact country/coverage and
# a real operator country-polygon dataset. Do NOT enable by flag alone.
# APP_ENABLE_US_NWS=false
# APP_NWS_USER_AGENT=UniversalWeatherAPI/1.0 (operator@example.org)
# APP_ENABLE_BRIGHT_SKY=false

# Phase 07A: default requires current weather. To run a forecast-only gateway,
# set APP_REQUIRED_CAPABILITIES=forecast and configure at least one policy-approved
# forecast adapter. Both capabilities may be required: weather,forecast.
# APP_REQUIRED_CAPABILITIES=weather
